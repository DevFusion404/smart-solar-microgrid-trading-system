<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_grid_operator_home.xml
    Screen 8 – Grid Operator Home
    Navigation Drawer + Toolbar layout with Fragment Container,
    using cyan accent styling.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gridOpDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Main content area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/gridOpToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/slate_900"
            android:elevation="4dp"
            app:navigationIcon="@drawable/ic_menu_hamburger"
            app:navigationIconTint="@color/cyan_accent"
            app:titleTextColor="@color/white" />

        <!-- Fragment Container for sub-screens -->
        <FrameLayout
            android:id="@+id/gridOpFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/background_light" />

    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/gridOpNavigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_card"
        android:fitsSystemWindows="true"
        app:elevation="16dp"
        app:headerLayout="@layout/nav_header_main"
        app:itemBackground="@drawable/bg_nav_item_selector"
        app:itemIconPadding="18dp"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item_tint_selector"
        app:itemShapeInsetEnd="12dp"
        app:itemShapeInsetStart="12dp"
        app:itemTextColor="@color/nav_item_text_selector"
        app:menu="@menu/drawer_menu_grid_operator"
        app:subheaderColor="@color/slate_500"
        app:subheaderTextAppearance="@style/Widget.SmartSolar.NavigationView.Subheader" />

</androidx.drawerlayout.widget.DrawerLayout>
