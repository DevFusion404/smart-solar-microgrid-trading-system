<?xml version="1.0" encoding="utf-8"?>
<!--
    Component 4 - the prosumer transfer pass.
    The QR encodes the payload minted by the backend: reservation id,
    transaction id, secure token and expiry.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarQr"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_card"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:title="@string/transfer_title_qr"
        app:titleTextColor="@color/slate_900" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/surface_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/imgQrCode"
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:background="@color/white"
                        android:contentDescription="@string/transfer_title_qr"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />

                    <ProgressBar
                        android:id="@+id/progressQr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:indeterminateTint="@color/solar_primary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvQrHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/transfer_qr_hint"
                        android:textColor="@color/slate_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvExpiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/reservation_pending"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Expires: 21 Sep 2026, 20:51" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Transfer details carried inside the QR payload -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/surface_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/transfer_label_transaction"
                        android:textColor="@color/slate_400"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTransactionId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/slate_900"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="TXN-20260921-1A2B3C" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/transfer_label_booking"
                        android:textColor="@color/slate_400"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvReservationId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/slate_700"
                        android:textSize="15sp"
                        tools:text="RES-20260921-30ADE6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/transfer_label_station"
                        android:textColor="@color/slate_400"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvStationName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/slate_700"
                        android:textSize="15sp"
                        tools:text="Colombo Solar Hub" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/transfer_label_energy"
                        android:textColor="@color/slate_400"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvEnergyAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/solar_primary_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="19.0 kWh" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvQrMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/status_red"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="This QR code has expired" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
