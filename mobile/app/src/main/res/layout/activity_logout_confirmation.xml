<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_logout_confirmation.xml
    Screen 14 – Logout Confirmation (Both Roles)
    Full-screen modal-style confirmation before signing out.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/logoutConfirmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC020617">

    <!-- Centered modal card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/logoutConfirmCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="28dp"
        app:cardElevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">

            <!-- Avatar + initial -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_logo_glow"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tvLogoutUserInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="U"
                    android:textColor="@color/slate_950"
                    android:textSize="26sp" />
            </FrameLayout>

            <!-- User display name -->
            <TextView
                android:id="@+id/tvLogoutUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="Your Name"
                android:textColor="@color/slate_900"
                android:textSize="16sp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/divider_light" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvLogoutTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="@string/logout_confirm_title"
                android:textColor="@color/slate_900"
                android:textSize="22sp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvLogoutSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/logout_confirm_subtitle"
                android:textColor="@color/slate_500"
                android:textSize="14sp" />

            <!-- Sign Out button (amber/primary) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmSignOut"
                style="@style/Widget.SmartSolar.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/btn_sign_out" />

            <!-- Stay Logged In outline button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStayLoggedIn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/btn_stay_logged_in"
                android:textColor="@color/slate_700"
                app:cornerRadius="14dp"
                app:strokeColor="@color/surface_stroke" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
