<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutInfoCardRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="250dp"
    android:maxWidth="300dp"
    android:background="@drawable/bg_map_info_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvInfoStationName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Station Name"
            android:textColor="@color/slate_900"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvInfoStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_reservation_status_available"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Active"
            android:textColor="@color/reservation_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvInfoAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Station Address"
        android:textColor="@color/slate_500"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvInfoCapacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 500 kW"
            android:textColor="@color/slate_700"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="•"
            android:textColor="@color/slate_300" />

        <TextView
            android:id="@+id/tvInfoBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋 250 kWh"
            android:textColor="@color/slate_700"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnTapToReserve"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_reservation_icon_cyan"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Tap to View Slots &amp; Reserve →"
            android:textColor="@color/reservation_blue"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>