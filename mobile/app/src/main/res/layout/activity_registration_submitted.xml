<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_registration_submitted.xml
    Screen 4 – Prosumer Registration Submitted
    Shown after RegisterActivity successfully submits the registration form.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/regSubmittedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header gradient area with logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="56dp"
                android:paddingBottom="40dp">

                <!-- Success icon circle (amber glow) -->
                <FrameLayout
                    android:id="@+id/successIconWrapper"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:background="@drawable/bg_logo_glow"
                    android:elevation="4dp"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/slate_950"
                        android:textSize="44sp"
                        android:fontFamily="sans-serif-black" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/brand_name"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/brand_tagline"
                    android:textColor="@color/solar_primary_light"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- White card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="32dp"
                app:cardElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="28dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="32dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvRegSubmittedTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="@string/reg_submitted_title"
                        android:textColor="@color/slate_900"
                        android:textSize="24sp" />

                    <!-- Subtitle -->
                    <TextView
                        android:id="@+id/tvRegSubmittedSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/reg_submitted_subtitle"
                        android:textColor="@color/slate_500"
                        android:textSize="14sp" />

                    <!-- Amber info card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_pending_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="🕐"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Under Review"
                                android:textColor="#92400E"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/reg_submitted_hint"
                                android:textColor="#B45309"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- What happens next card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card_surface"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="What happens next?"
                            android:textColor="@color/slate_700"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="① A grid operator reviews your application\n② Your account is activated or you\'re notified\n③ Log in and start trading solar energy"
                            android:textColor="@color/slate_500"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.5" />
                    </LinearLayout>

                    <!-- Back to Login Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegSubmittedBackToLogin"
                        style="@style/Widget.SmartSolar.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="@string/btn_back_to_login" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
