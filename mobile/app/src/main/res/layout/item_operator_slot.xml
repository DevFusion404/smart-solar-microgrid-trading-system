<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/surface_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Slot ID, Time window, Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOperatorSlotId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_role_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="SLOT-01"
                android:textColor="@color/cyan_accent_dark"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOperatorSlotTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="08:00 AM - 12:00 PM"
                android:textColor="@color/slate_900"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvOperatorSlotStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_reservation_status_available"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="AVAILABLE"
                android:textColor="@color/status_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Date Row with Calendar Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Date"
                android:src="@drawable/ic_nav_calendar"
                app:tint="@color/slate_400" />

            <TextView
                android:id="@+id/tvOperatorSlotDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="2026-09-17"
                android:textColor="@color/slate_500"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Capacity Progress Bar -->
        <ProgressBar
            android:id="@+id/pbSlotUtilization"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="70"
            android:progressTint="@color/solar_primary" />

        <!-- Capacity Numbers Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVAILABLE / TOTAL"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOperatorSlotCapacityRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="350 / 500 kWh"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateSlotCapacity"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/cyan_accent_dark"
                android:paddingHorizontal="14dp"
                android:text="Update Capacity"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_nav_energy"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="14dp"
                app:iconTint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
