<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nav_header"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="48dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <!-- Top App Logo & Name Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_logo_glow"
            android:padding="0dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="@string/brand_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo4" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.03"
            android:text="Smart Solar"
            android:textColor="@color/white"
            android:textSize="19sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="#26FFFFFF" />

    <!-- User Profile Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- User Avatar Circle with Amber Ring -->
        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_logo_glow"
            android:elevation="4dp"
            android:padding="2dp">

            <TextView
                android:id="@+id/tvNavUserInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_logo_glow"
                android:gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="U"
                android:textColor="@color/slate_900"
                android:textSize="22sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <!-- User Name -->
            <TextView
                android:id="@+id/tvNavUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/default_user_name"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <!-- User Role Badge -->
            <TextView
                android:id="@+id/tvNavUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_role_badge"
                android:fontFamily="sans-serif-medium"
                android:text="@string/default_user_role"
                android:textColor="@color/solar_primary_light"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
