<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- Top Bar with Summary and Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Assigned Microgrid Nodes"
                android:textColor="@color/slate_900"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvOperatorMapSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Loading assigned nodes..."
                android:textColor="@color/slate_500"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshMap"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_nav_sync"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="18dp"
            app:iconTint="@color/slate_700"
            app:strokeColor="@color/surface_stroke" />
    </LinearLayout>

    <!-- Map View Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/mapViewOperatorNodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Hint Card on Map -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#E60F172A"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Map pin"
                    android:src="@drawable/ic_nav_station"
                    app:tint="@color/solar_primary_light" />

                <TextView
                    android:id="@+id/tvMapHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tap marker to view details &amp; manage slots"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Floating My Location Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Locate me on map"
            app:backgroundTint="@color/white"
            app:elevation="4dp"
            app:fabSize="mini"
            app:rippleColor="@color/slate_200"
            app:srcCompat="@drawable/ic_my_location"
            app:tint="@color/slate_900" />

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/pbMapLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/solar_primary"
            android:visibility="gone" />

        <!-- Empty State overlay for Map -->
        <LinearLayout
            android:id="@+id/layoutEmptyMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D9FFFFFF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="No markers"
                android:src="@drawable/ic_nav_station"
                app:tint="@color/slate_400" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="No Assigned Nodes on Map"
                android:textColor="@color/slate_800"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="No microgrid nodes are currently assigned to your account with GPS coordinates."
                android:textColor="@color/slate_500"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Floating Bottom Station Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapNodePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPreviewNodeName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/slate_900"
                        android:textSize="16sp"
                        tools:text="Pannipitiya Microgrid Node" />

                    <TextView
                        android:id="@+id/tvPreviewStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_reservation_status_available"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="ACTIVE"
                        android:textColor="@color/status_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnClosePreview"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Close preview"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/slate_400" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPreviewNodeCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/solar_primary_dark"
                    android:textSize="12sp"
                    tools:text="Node ID: ST001" />

                <TextView
                    android:id="@+id/tvPreviewAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/slate_500"
                    android:textSize="12sp"
                    tools:text="High Level Rd, Pannipitiya" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPreviewCapacity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/slate_700"
                        android:textSize="12sp"
                        tools:text="⚡ 100 kW Capacity" />

                    <TextView
                        android:id="@+id/tvPreviewBattery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/slate_700"
                        android:textSize="12sp"
                        tools:text="🔋 250 kWh Battery" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPreviewNodeDetails"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Node Details"
                        android:textColor="@color/slate_700"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/surface_stroke" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPreviewManageSlots"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/solar_primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="⚡ Manage Slots"
                        android:textColor="@color/slate_950"
                        android:textSize="12sp"
                        app:cornerRadius="10dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</LinearLayout>
