<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_reservation_icon_cyan"
            android:padding="10dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Update slot icon"
                android:src="@drawable/ic_nav_energy"
                app:tint="@color/reservation_blue" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Update Slot Availability"
                android:textColor="@color/slate_900"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvUpdateSlotBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SLOT-01 • 08:00 AM - 12:00 PM"
                android:textColor="@color/cyan_accent_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Slot Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_role_badge"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvUpdateSlotTotalCap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total: 50.0 kWh"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUpdateSlotCurrentAvail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Available: 35.0 kWh"
            android:textColor="@color/status_green"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Available Capacity Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilUpdateSlotAvailable"
        style="@style/Widget.SmartSolar.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="New Available Capacity (kWh)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUpdateSlotAvailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@color/slate_900" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Slot Status Selection (Available / Closed) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilUpdateSlotStatus"
        style="@style/Widget.SmartSolar.TextInputLayout.ExposedDropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Slot Status">

        <AutoCompleteTextView
            android:id="@+id/actvUpdateSlotStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:text="Available"
            android:textColor="@color/slate_900" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelUpdateSlot"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/slate_600" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitUpdateSlot"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/cyan_accent_dark"
            android:text="Save Availability"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_nav_sync"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/white" />
    </LinearLayout>

</LinearLayout>
