<?xml version="1.0" encoding="utf-8"?>
<!--
    Component 4 - Grid operator transfer dashboard.
    Counters come from GET /api/dashboard/operator.
    Modernized to match the Microgrid Gradient & Glassmorphism theme.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- Top Bar & Hero Section with Splash Gradient -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_splash_gradient"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Custom Sleek Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarOperator"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/transparent"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            app:title="@string/transfer_title_operator_dashboard"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            app:titleTextColor="@color/white">

            <TextView
                android:id="@+id/tvLiveTransferBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_reservation_status_available"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ONLINE"
                android:textColor="@color/status_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Header Info Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="2dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Energy Transfer Control"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Verify passes, deliver power &amp; track completions"
                android:textColor="@color/cyan_accent_light"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Glassmorphism KPI Stat Cards Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp">

            <!-- Pending Transfers Card (Amber Glass) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card_amber"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_reservation_icon_amber"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Pending"
                            android:src="@drawable/ic_nav_calendar"
                            app:tint="@color/solar_primary" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="PENDING"
                        android:textColor="@color/solar_amber_accent"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCountPendingTransfers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="In queue"
                    android:textColor="@color/slate_300"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Today's Transfers Card (Cyan Glass) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card_cyan"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_reservation_icon_cyan"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Today"
                            android:src="@drawable/ic_nav_energy"
                            app:tint="@color/cyan_accent_light" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="TODAY"
                        android:textColor="@color/cyan_accent_light"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCountToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Processed"
                    android:textColor="@color/slate_300"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Completed Transfers Card (Emerald Glass) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card_emerald"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_reservation_icon_emerald"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Completed"
                            android:src="@drawable/ic_nav_sync"
                            app:tint="@color/status_green" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="DONE"
                        android:textColor="@color/status_green"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCountCompletedTransfers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Completed"
                    android:textColor="@color/slate_300"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Area with Swipe Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshOperator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Actions Section Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/surface_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.05"
                            android:text="TRANSFER ACTIONS"
                            android:textColor="@color/slate_500"
                            android:textSize="12sp" />

                        <!-- Primary: Scan QR Code -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScanQr"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_btn_primary_gradient"
                            app:backgroundTint="@null"
                            android:fontFamily="sans-serif-bold"
                            android:text="Scan Transfer QR Code"
                            android:textColor="@color/slate_950"
                            android:textSize="14sp"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_nav_energy"
                            app:iconGravity="textStart"
                            app:iconTint="@color/slate_950" />

                        <!-- Two Action Buttons Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <!-- Pending Queue Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPendingReservations"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/cyan_subtle"
                                android:fontFamily="sans-serif-bold"
                                android:text="Queue"
                                android:textColor="@color/cyan_accent_dark"
                                android:textSize="13sp"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_nav_calendar"
                                app:iconTint="@color/cyan_accent_dark"
                                app:iconSize="18dp"
                                app:strokeColor="@color/cyan_accent"
                                app:strokeWidth="1dp" />

                            <!-- History Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTransactionHistory"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-bold"
                                android:text="History"
                                android:textColor="@color/slate_700"
                                android:textSize="13sp"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_nav_sync"
                                app:iconTint="@color/slate_600"
                                app:iconSize="18dp"
                                app:strokeColor="@color/surface_stroke"
                                app:strokeWidth="1dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pending Queue Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="Pending Energy Transfers"
                        android:textColor="@color/slate_900"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to verify"
                        android:textColor="@color/cyan_accent_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- RecyclerView for Pending Transfers -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPendingTransfers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false" />

                <!-- Empty State Message -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/surface_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_reservation_icon_cyan"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Empty"
                                android:src="@drawable/ic_nav_energy"
                                app:tint="@color/cyan_accent_dark" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvOperatorMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:textColor="@color/slate_500"
                            android:textSize="14sp"
                            tools:text="No pending transfers at this time" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
