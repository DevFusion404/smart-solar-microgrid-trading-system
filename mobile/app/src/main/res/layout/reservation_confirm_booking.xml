<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/slate_200" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBookingStationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm your reservation"
                    android:textColor="@color/slate_900"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Review availability before securing your energy."
                    android:textColor="@color/slate_500"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDismissBookingSheet"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_reservation_outline"
                android:contentDescription="Close booking confirmation"
                android:padding="11dp"
                android:src="@drawable/ic_nav_logout"
                app:tint="@color/slate_500" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/slate_50"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Colombo Solar Hub"
                    android:textColor="@color/slate_900"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBookingSlotSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Today, 09:00 AM - 10:00 AM"
                    android:textColor="@color/slate_600"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/surface_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Available now"
                        android:textColor="@color/slate_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvBookingAvailableCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="210 kWh"
                        android:textColor="@color/reservation_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilReservationCapacity"
            style="@style/Widget.SmartSolar.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Energy to reserve (kWh)"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReservationCapacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/slate_900"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.15"
            android:text="Your reservation will remain pending until the microgrid confirms available delivery capacity."
            android:textColor="@color/slate_500"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmReservation"
            style="@style/Widget.SmartSolar.ReservationButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="-1dp"
            android:layout_marginEnd="-1dp"
            android:layout_marginTop="14dp"
            android:text="Confirm reservation"
            android:textAllCaps="false"
            app:icon="@drawable/ic_nav_calendar"
            app:iconGravity="textStart"
            app:iconTint="@color/slate_950" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
