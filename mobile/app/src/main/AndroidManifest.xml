<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Network Checking Permissions ── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ── Camera Permissions ── -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- ── Google Maps & Location Permissions ── -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo4"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo4"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartSolarMobile"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- Splash Screen (App Entry Point) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartSolarMobile.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Screen -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register Screen (Prosumer Registration – Screen 3) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Screen / Prosumer Home (Navigation Drawer Container – Screen 7) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Screen 4: Registration Submitted (Prosumer) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.RegistrationSubmittedActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Screen 5: Pending Activation (Prosumer) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.PendingActivationActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Screen 6: Role Redirection (Both Roles) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.RoleRedirectionActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile.Splash" />

        <!-- Screen 8: Grid Operator Home -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.GridOperatorActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Screen 11: Request Deactivation (Mainly Prosumer) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.RequestDeactivationActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 12: Deactivation Request Submitted (Prosumer) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.DeactivationSubmittedActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Screen 13: Account Deactivated (Both Roles) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.AccountDeactivatedActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Screen 14: Logout Confirmation (Both Roles) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.LogoutConfirmationActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Screen 15: Session Expired (Both Roles) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.SessionExpiredActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Settings Screen -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- ============================================================
             Component 4: Dashboards, QR Verification and Energy Transfer
             ============================================================ -->

        <!-- Component 4: Prosumer transfer dashboard -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.ProsumerDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Current bookings (verified, awaiting handover) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.CurrentBookingActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Pending bookings (QR issued, unscanned) -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.PendingBookingActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Approved reservations ready for a QR -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.ApprovedBookingActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Secure transfer QR display -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.QRCodeActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Completed transfer history -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.BookingHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Search and filter bookings -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.BookingSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Grid operator transfer dashboard -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.OperatorDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Operator-wide transaction history -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.OperatorTransactionHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Reservation approval queue - approving issues the QR pass -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.PendingReservationsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Camera QR scanner - portrait only so the preview does not re-create mid-scan -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.QRScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: QR verification result and operator decision -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.QRVerificationActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

        <!-- Component 4: Energy transfer completion -->
        <activity
            android:name="com.smartsolar.mobile.ui.activity.transfer.CompleteTransferActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartSolarMobile" />

    </application>

</manifest>